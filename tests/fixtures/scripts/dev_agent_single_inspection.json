{
 "dev-r01": [
  {
   "summary": "Read the log first.",
   "action": {
    "tool": "inspect_log",
    "arguments": {
     "run_id": "dev-r01",
     "start_line": 1,
     "end_line": 60
    }
   }
  },
  {
   "summary": "Check the relevant config values.",
   "action": {
    "tool": "read_config",
    "arguments": {
     "run_id": "dev-r01",
     "keys": [
      "diffusivity",
      "diffusivity_units",
      "provenance_note",
      "dt"
     ]
    }
   }
  },
  {
   "summary": "Run the static validator.",
   "action": {
    "tool": "validate_config",
    "arguments": {
     "run_id": "dev-r01"
    }
   }
  },
  {
   "summary": "The lab sheet gives cm2/s; fix the unit field.",
   "action": {
    "tool": "propose_patch",
    "arguments": {
     "run_id": "dev-r01",
     "field": "diffusivity_units",
     "new_value": "cm2/s",
     "expected_revision": 0
    }
   }
  },
  {
   "summary": "Test the patch on a copy.",
   "action": {
    "tool": "test_patch",
    "arguments": {
     "patch_id": "P1"
    }
   }
  },
  {
   "summary": "Checks pass; ask for approval.",
   "action": {
    "tool": "request_approval",
    "arguments": {
     "patch_id": "P1"
    }
   }
  },
  {
   "summary": "Apply with the token I was given.",
   "action": {
    "tool": "apply_patch",
    "arguments": {
     "patch_id": "P1",
     "approval_token": "APR-8ca13beb1d15"
    }
   }
  },
  {
   "summary": "Diffusivity was read as m2/s instead of cm2/s.",
   "action": {
    "tool": "finish",
    "arguments": {
     "diagnosis": "unit_conversion",
     "summary": "Diffusivity was read as m2/s instead of cm2/s."
    }
   }
  }
 ],

  },
  {
   "summary": "Apply with the token I was given.",
   "action": {
    "tool": "apply_patch",
    "arguments": {
     "patch_id": "P1",
     "approval_token": "APR-0396962aebf5"
    }
   }
  },
  {
   "summary": "Undo the last change.",
   "action": {
    "tool": "rollback",
    "arguments": {

 "ho-r01": [
  {
   "summary": "Read the log first.",
   "action": {
    "tool": "inspect_log",
    "arguments": {
     "run_id": "ho-r01",
     "start_line": 1,
     "end_line": 60
    }
   }
  },
  {
   "summary": "Check the relevant config values.",
   "action": {
    "tool": "read_config",
    "arguments": {
     "run_id": "ho-r01",
     "keys": [
      "learning_rate",
      "momentum",
      "max_iter"
     ]
    }
   }
  },
  {
   "summary": "Overflow at the first iterations; reduce the step size.",
   "action": {
    "tool": "propose_patch",
    "arguments": {
     "run_id": "ho-r01",
     "field": "learning_rate",
     "new_value": 0.02,
     "expected_revision": 0
    }
   }
  },
  {
   "summary": "Test the patch on a copy.",
   "action": {
    "tool": "test_patch",
    "arguments": {
     "patch_id": "P1"
    }
   }
  },
  {
   "summary": "Checks pass; ask for approval.",
   "action": {
    "tool": "request_approval",
    "arguments": {
     "patch_id": "P1"
    }
   }
  },
  {
   "summary": "Apply with the token I was given.",
   "action": {
    "tool": "apply_patch",
    "arguments": {
     "patch_id": "P1",
     "approval_token": "APR-e0b342df7c2b"
    }
   }
  },
  {
   "summary": "Learning rate too large for this function.",
   "action": {
    "tool": "finish",
    "arguments": {
     "diagnosis": "step_size_too_large",
     "summary": "Learning rate too large for this function."
    }
   }
  }
